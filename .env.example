# bot:play スコープの認証トークン。
LISHOGI_BOT_TOKEN=
# コンテナ全体のメモリ上限(スワップの追加使用は認めない)。config.yml の USI_Hash に同時対局数を掛けた値より大きくする。
MINASE_LISHOGI_BOT_MEMORY_LIMIT=6g
# コンテナ全体の CPU 割当(コア数)。config.yml の Threads に同時対局数を掛けた値にする。
MINASE_LISHOGI_BOT_CPU_LIMIT=8
# コンテナのユーザーの uid と gid。logs/ を所有するホストのユーザーの `id -u` と `id -g` の値にする。
MINASE_LISHOGI_BOT_UID=1000
MINASE_LISHOGI_BOT_GID=1000
