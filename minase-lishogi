#!/bin/sh
# Lishogi-Bot から minase を起動するための固定引数ラッパー。
# Lishogi-Bot は engine_options を与えると起動コマンドをリストのまま shell=True で
# Popen に渡すため引数が捨てられる(engine_wrapper.py、engine_ctrl/usi.py open_process)。
# そのため引数なしで起動できる本スクリプトを engine.name に指定する。
# 規則セットと評価ネットは起動引数ではなく、config.yml の usi_options(RuleSet、EvalFile)で渡す。
exec /opt/minase/minase --protocol usi "$@"
